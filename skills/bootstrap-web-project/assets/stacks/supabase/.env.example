# Supabase. Read local values from `corepack yarn db:status` after `db:start`.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe for browsers, enforced by Row Level Security.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: bypasses Row Level Security. Server-side only, never in a client bundle.
SUPABASE_SECRET_KEY=
