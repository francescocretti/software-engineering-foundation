# Copy to .env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=http://localhost:5173
# Requests per client within RATE_LIMIT_WINDOW (a duration such as "1 minute").
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Maximum request body size in bytes.
BODY_LIMIT=1048576
# Set to true only behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false
