# Copy to .env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins allowed by CORS. Empty disables CORS.
CORS_ORIGINS=http://localhost:5173
# Requests per client within THROTTLE_TTL_MS milliseconds.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
